{
  "guardrails": {
    "trees": {
      "requirements": {
        "path": "../shoddy-planning/requirements",
        "can": ["list", "read"],
        "scopes": {
          "backlog":    { "can": ["list", "read", "create", "update", "rename"] },
          "inprogress": { "can": ["list", "read", "create", "update", "rename"] },
          "evaluation": { "can": ["list", "read", "create", "update", "rename", "delete", "execute"] },
          "cancelled":  { "can": [] },
          "completed":  { "can": [] }
        }
      }
    },
    "replacements": {
      "feature-branch":  "pool",
      "bug-branch":      "pool03",
      "release-version": "2.2.1",
      "commit-note":     "Each edit or find in a batch needs its on starting point."
    }
  }
}
