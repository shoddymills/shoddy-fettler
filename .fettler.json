{
  "guardrails": {
    "trees": {
      "work": {
        "path": ".",
        "can": ["list", "read", "create", "update", "rename", "delete", "execute"]
      },
      "shoddy": {
        "path": "../shoddy",
        "can": ["list", "read"]
      }
    },
    "tasks": {

      "build":              { "run": "pwsh -NoProfile -File scripts/fettler-build.ps1 build",   "cwd": "." },
      "test":               { "run": "pwsh -NoProfile -File scripts/fettler-build.ps1 test",    "cwd": "." },
      "check":              { "run": "pwsh -NoProfile -File scripts/fettler-build.ps1 check",   "cwd": "." },
      "release":            { "run": "pwsh -NoProfile -File scripts/fettler-build.ps1 release", "cwd": "." },
      "publish":            { "run": "pwsh -NoProfile -File scripts/fettler-build.ps1 publish {release-version}", "cwd": "." },

      "verify-docs":        { "run": "node scripts/fettler-verify-docs.js",        "cwd": "." },
      "verify-errors":      { "run": "node scripts/fettler-verify-errors.js",      "cwd": "." },
      "verify-twins":       { "run": "node scripts/fettler-verify-twins.js",       "cwd": "." },
      "verify-permissions": { "run": "node scripts/fettler-verify-permissions.js --check", "cwd": "." },
      "survey-readability": { "run": "node scripts/fettler-survey-readability.js", "cwd": "." },
      "sitemap":            { "run": "pwsh -NoProfile -File scripts/fettler-make-sitemap.ps1", "cwd": "." },
      "install":            { "run": "pwsh -NoProfile -File scripts/fettler-install.ps1 {release-version}", "cwd": "." },
      "install-pick":       { "run": "pwsh -NoProfile -File scripts/fettler-install.ps1 {release-version} -Program pick",   "cwd": "." },
      "install-burler":     { "run": "pwsh -NoProfile -File scripts/fettler-install.ps1 {release-version} -Program burler", "cwd": "." },

      "feature":            { "run": "pwsh -NoProfile -File scripts/fettler-branch.ps1 feature {feature-branch}", "cwd": "." },
      "bug":                { "run": "pwsh -NoProfile -File scripts/fettler-branch.ps1 bug {bug-branch}", "cwd": "." },
      "sync":               { "run": "pwsh -NoProfile -File scripts/fettler-branch.ps1 sync", "cwd": "." },
      "land":               { "run": "pwsh -NoProfile -File scripts/fettler-branch.ps1 land -Yes", "cwd": "." },
      "checkin":            { "run": "pwsh -NoProfile -File scripts/fettler-checkin.ps1 -Message {commit-note}", "cwd": "." },
      "pr":                 { "run": "pwsh -NoProfile -File scripts/fettler-pr.ps1", "cwd": "." },
      "ship":               { "run": "pwsh -NoProfile -File scripts/fettler-ship.ps1 {release-version} -Yes", "cwd": "." }
    }
  }
}
