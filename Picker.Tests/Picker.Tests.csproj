<Project Sdk="Microsoft.NET.Sdk">

  <!-- Picker's proof. The grant matrix, the resolver and the whole
       query gate are pure - strings in, verdicts out - so nearly all of
       this runs with a catalog made of literals and no server in the
       room. The LocalDB tests are the exception, and they SKIP WITH A
       REASON where LocalDB is absent: a skip nobody can see is a test
       that quietly stopped existing.

       The test packages here are the one place third-party references
       are allowed in this lane, and they are deliberately outside what
       the independence test guards: it reads the references of the
       SHIPPED assemblies, Picker and pick, not of the harness that
       grades them. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Picker.Tests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Picker\Picker.csproj" />
    <ProjectReference Include="..\pick\pick.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
  </ItemGroup>

</Project>
